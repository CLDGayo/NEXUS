# Secrets
rag/.env
**/.env

# Python
__pycache__/
*.pyc
.venv/
rag/.venv/

# Quartz build output
_publish/node_modules/
_publish/public/

# macOS
.DS_Store

# Knowledge graph — regenerated locally by graphify, not source.
# Root-anchored so it never shadows tracked process/**/ paths.
/graphify-out/

# Scratch research reports dropped at the repo root by Explore agents.
# Durable reports live under process/**/reports/ and stay tracked.
/reports/

# Runtime data — application logs and SQLite databases live here.
# Never commit. The deploy script rsyncs sources only.
rag/data/*.log
rag/data/*.db
rag/data/*.db-journal
rag/data/*.db-wal
rag/data/*.db-shm
rag/data/traces/
rag/data/.password_override.json
rag/data/.messenger_override.json
rag/.ingest_state.json

# OWASP ZAP scan reports — large (multi-MB) HTML snapshots from security scans.
# Excluded from deploy rsync too (see deploy-rag.sh). Findings are tracked in
# commit messages / process reports, not the raw report.
OwaspZapReports/
